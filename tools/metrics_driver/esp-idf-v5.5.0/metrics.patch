+static void gdma_metrics_track(gdma_channel_handle_t channel, gdma_trigger_t trigger)
+{
+    if (trigger.periph != GDMA_TRIG_PERIPH_I2S || trigger.instance_id != SOC_GDMA_TRIG_PERIPH_I2S0) return;
+    portENTER_CRITICAL(&gdma_driver_metrics_lock);
+    size_t slot = GDMA_METRICS_TRACKED_CHANNELS;
+    for (size_t i = 0; i < GDMA_METRICS_TRACKED_CHANNELS; ++i) {
+        if (gdma_metrics_channels[i].channel == channel) { slot = i; break; }
+        if (!gdma_metrics_channels[i].channel && slot == GDMA_METRICS_TRACKED_CHANNELS) slot = i;
+    }
+    if (slot < GDMA_METRICS_TRACKED_CHANNELS) {
+        gdma_metrics_channels[slot].channel = channel;
+        gdma_metrics_channels[slot].peripheral = trigger.periph;
+        gdma_metrics_channels[slot].instance_id = trigger.instance_id;
+    } else gdma_driver_metrics.events_valid = 0;
+    portEXIT_CRITICAL(&gdma_driver_metrics_lock);
+}
+static void gdma_metrics_untrack(gdma_channel_handle_t channel)
+{
+    portENTER_CRITICAL(&gdma_driver_metrics_lock);
+    for (size_t i = 0; i < GDMA_METRICS_TRACKED_CHANNELS; ++i) {
