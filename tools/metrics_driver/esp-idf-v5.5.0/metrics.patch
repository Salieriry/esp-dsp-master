+static void IRAM_ATTR i2s_metrics_event(bool tx, uint32_t bytes, bool queue_error, uint32_t cycles, bool same_core)
+{
+    portENTER_CRITICAL_ISR(&i2s_driver_metrics_lock);
+    uint32_t *errors = tx ? &i2s_driver_metrics.tx_errors : &i2s_driver_metrics.rx_errors;
+    uint64_t *total = tx ? &i2s_driver_metrics.tx_callback_cycles_total : &i2s_driver_metrics.rx_callback_cycles_total;
+    uint32_t *maximum = tx ? &i2s_driver_metrics.tx_callback_cycles_max : &i2s_driver_metrics.rx_callback_cycles_max;
+    if (tx) { ++i2s_driver_metrics.tx_interrupts; i2s_driver_metrics.tx_bytes += bytes; }
+    else { ++i2s_driver_metrics.rx_interrupts; i2s_driver_metrics.rx_bytes += bytes; }
+    if (queue_error) ++*errors;
+    if (same_core) { *total += cycles; if (cycles > *maximum) *maximum = cycles; }
+    else i2s_driver_metrics.timing_valid = 0;
+    portEXIT_CRITICAL_ISR(&i2s_driver_metrics_lock);
+}
+static void i2s_metrics_memory(bool tx, bool descriptor, uint32_t bytes, bool allocate)
+{
+    portENTER_CRITICAL(&i2s_driver_metrics_lock);
+    uint32_t *value = descriptor ? (tx ? &i2s_driver_metrics.tx_descriptor_bytes : &i2s_driver_metrics.rx_descriptor_bytes) :
+                                   (tx ? &i2s_driver_metrics.tx_buffer_bytes : &i2s_driver_metrics.rx_buffer_bytes);
+    if (allocate) { if (UINT32_MAX - *value < bytes) i2s_driver_metrics.memory_valid = 0; else *value += bytes; }
+    else if (*value >= bytes) *value -= bytes;
+    else { *value = 0; i2s_driver_metrics.memory_valid = 0; }
+    portEXIT_CRITICAL(&i2s_driver_metrics_lock);
+}
+static void i2s_metrics_copy(bool tx, uint32_t cycles, bool same_core)
+{
+    portENTER_CRITICAL(&i2s_driver_metrics_lock);
+    uint64_t *total = tx ? &i2s_driver_metrics.tx_copy_cycles_total : &i2s_driver_metrics.rx_copy_cycles_total;
+    uint32_t *maximum = tx ? &i2s_driver_metrics.tx_copy_cycles_max : &i2s_driver_metrics.rx_copy_cycles_max;
+    if (same_core) { *total += cycles; if (cycles > *maximum) *maximum = cycles; }
+    else i2s_driver_metrics.timing_valid = 0;
+    portEXIT_CRITICAL(&i2s_driver_metrics_lock);
+}
+static void i2s_metrics_wait(bool tx, uint64_t elapsed_us)
+{
+    portENTER_CRITICAL(&i2s_driver_metrics_lock);
+    if (tx) i2s_driver_metrics.tx_wait_us += elapsed_us; else i2s_driver_metrics.rx_wait_us += elapsed_us;
+    portEXIT_CRITICAL(&i2s_driver_metrics_lock);
+}
+void i2s_driver_metrics_snapshot(DmaDriverMetrics *out)
+{
+    if (!out) return;
+    portENTER_CRITICAL(&i2s_driver_metrics_lock);
+    *out = i2s_driver_metrics;
+    portEXIT_CRITICAL(&i2s_driver_metrics_lock);
+}
+uint32_t i2s_driver_metrics_storage_bytes(void)
+{
+    return sizeof(i2s_driver_metrics) + sizeof(i2s_driver_metrics_lock);
+}
+void i2s_driver_metrics_reset(void)
+{
+    portENTER_CRITICAL(&i2s_driver_metrics_lock);
+    uint32_t rx_buffer = i2s_driver_metrics.rx_buffer_bytes, tx_buffer = i2s_driver_metrics.tx_buffer_bytes;
+    uint32_t rx_desc = i2s_driver_metrics.rx_descriptor_bytes, tx_desc = i2s_driver_metrics.tx_descriptor_bytes;
+    uint8_t memory_valid = i2s_driver_metrics.memory_valid;
+    memset(&i2s_driver_metrics, 0, sizeof(i2s_driver_metrics));
+    i2s_driver_metrics.rx_buffer_bytes = rx_buffer; i2s_driver_metrics.tx_buffer_bytes = tx_buffer;
+    i2s_driver_metrics.rx_descriptor_bytes = rx_desc; i2s_driver_metrics.tx_descriptor_bytes = tx_desc;
+    i2s_driver_metrics.events_valid = 1; i2s_driver_metrics.memory_valid = memory_valid; i2s_driver_metrics.timing_valid = 1;
+    portEXIT_CRITICAL(&i2s_driver_metrics_lock);
+}
 
